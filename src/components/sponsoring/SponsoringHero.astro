---
import { Picture } from 'astro:assets'
import amphi from '../../assets/sponsoring/amphi.jpg'
import ButtonLink from '../ui-elements/ButtonLink.astro'
import Cluster from '../ui-elements/Cluster.astro'
import { EVENT } from '../../og/event'
import { SPONSORS_FORM_URL } from './sponsoringData'
---

<header class="hero">
    <Picture src={amphi} formats={['avif', 'webp']} alt="" class="hero-bg" loading="eager" widths={[800, 1600]} />
    <div class="hero-content">
        <p class="hero-eyebrow">Dossier de sponsoring</p>
        <h1>Sponsorisez Sunny Tech {EVENT.year}</h1>
        <p class="fs1">{EVENT.displayDates} — {EVENT.city}</p>
        <Cluster justify="center">
            <ButtonLink href={SPONSORS_FORM_URL} target="_blank" rel="noopener noreferrer" external>
                Devenir sponsor
            </ButtonLink>
            <ButtonLink href="#formules" variant="transparent">Voir les formules</ButtonLink>
        </Cluster>
    </div>
</header>

<style>
    .hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: min(70svh, 40rem);
        padding: 4rem 1rem;
        margin-top: -4rem;
        text-align: center;
        color: var(--brand-contrast);
        isolation: isolate;

        &::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background: linear-gradient(180deg, rgb(0 0 0 / 0.35), rgb(144 31 38 / 0.75));
        }
    }

    .hero :global(.hero-bg) {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        padding-top: 4rem;
    }

    .hero-eyebrow {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.12em;
    }

    h1 {
        font-size: var(--fs5);
    }
</style>
