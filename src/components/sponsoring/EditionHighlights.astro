---
import { Picture } from 'astro:assets'
import venue from '../../assets/sponsoring/venue-institut-agro.jpg'
import standCrowd from '../../assets/sponsoring/stand-crowd.jpg'
import talk from '../../assets/sponsoring/talk.jpg'
import workshop from '../../assets/sponsoring/workshop.jpg'
import ouisnap from '../../assets/sponsoring/ouisnap.jpg'
import volunteers from '../../assets/sponsoring/volunteers.jpg'
import ContentContainer from '../ui-elements/ContentContainer.astro'
import ButtonLink from '../ui-elements/ButtonLink.astro'
import Cluster from '../ui-elements/Cluster.astro'
import { FLASHBACK_FIGURES, FLASHBACK_LINKS, TRUSTED_BRANDS } from './sponsoringData'

const gallery = [
    { src: standCrowd, alt: 'Des participant·e·s sur un stand sponsor' },
    { src: talk, alt: 'Un amphithéâtre plein pendant un talk' },
    { src: workshop, alt: 'Un atelier pratique en petit groupe' },
    { src: ouisnap, alt: 'Des participant·e·s devant la borne photo OuiSnap !' },
]

const news = [
    {
        title: 'L’Institut Agro (SupAgro)',
        image: venue,
        imageAlt: 'Les participant·e·s entre les stands sponsors, sous les pins du campus de L’Institut Agro',
        points: [
            'Le campus de l’édition 2025, au cœur d’un parc arboré',
            'L’espace sponsors devant l’entrée des amphithéâtres',
            'Parking gratuit sur le campus',
        ],
    },
    {
        // No artwork for the 2027 theme yet: a CSS starfield stands in for it.
        title: 'Thème 2027 : l’Espace',
        theme: 'Espace',
        points: [
            'Déco, activités et communication autour du thème',
            'Nous vous recommandons de personnaliser votre stand aux couleurs de l’Espace',
            'Un accompagnement des sponsors pour s’immerger dans le thème',
        ],
    },
    {
        title: 'Un suivi dédié',
        image: volunteers,
        points: [
            'Une fréquentation accrue de vos stands grâce à un jeu mis en place ensemble*',
            'Un canal Slack dédié pour répondre à vos questions et préparer votre participation',
        ],
        note: '* Réservé aux formules de sponsoring classiques.',
    },
]
---

<ContentContainer spaceBlock="3rem">
    <div class="section-head">
        <h2>L’édition 2026</h2>
    </div>
    <dl class="figures">
        {
            FLASHBACK_FIGURES.map((figure) => (
                <div>
                    <dt>{figure.label}</dt>
                    <dd>{figure.value}</dd>
                </div>
            ))
        }
    </dl>
    <div class="gallery">
        {
            gallery.map((photo) => (
                <Picture
                    src={photo.src}
                    alt={photo.alt}
                    formats={['avif', 'webp']}
                    widths={[400, 700]}
                    sizes="(min-width: 960px) 300px, 50vw"
                />
            ))
        }
    </div>
    <Cluster>
        {
            FLASHBACK_LINKS.map((link) => (
                <ButtonLink href={link.href} target="_blank" rel="noopener noreferrer" external>
                    {link.label}
                </ButtonLink>
            ))
        }
    </Cluster>

    <h2>Ils nous ont fait confiance</h2>
    <ul class="logos">
        {
            TRUSTED_BRANDS.map((brand) => (
                <li>
                    <img src={brand.logo} alt={brand.name} title={brand.name} loading="lazy" />
                </li>
            ))
        }
    </ul>

    <div class="section-head">
        <h2>En 2027</h2>
    </div>
    <div class="news">
        {
            news.map((item) => (
                <article>
                    {item.image ? (
                        <Picture
                            src={item.image}
                            alt={item.imageAlt ?? ''}
                            formats={['avif', 'webp']}
                            widths={[400, 700]}
                            sizes="(min-width: 960px) 400px, 100vw"
                        />
                    ) : (
                        <div class="theme-visual">
                            <span>{item.theme}</span>
                        </div>
                    )}
                    <div class="news-body">
                        <h3>{item.title}</h3>
                        <ul>
                            {item.points.map((point) => (
                                <li>{point}</li>
                            ))}
                        </ul>
                        {item.note && <p class="note">{item.note}</p>}
                    </div>
                </article>
            ))
        }
    </div>
</ContentContainer>

<style>
    .figures {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(min(8rem, 100%), 1fr));

        div {
            display: flex;
            flex-direction: column-reverse;
            justify-content: flex-end;
            text-align: center;
        }

        dd {
            font-size: var(--fs5);
            font-weight: 700;
            color: var(--brand-solid);
            line-height: 1.1;
        }

        dt {
            color: var(--text-subtle);
        }
    }

    .gallery {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));

        :global(img) {
            width: 100%;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            border-radius: 0.5rem;
        }
    }

    .logos {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
        padding: 0;
        list-style: none;

        li {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem;
            aspect-ratio: 3 / 2;
            border-radius: 0.5rem;
            background: var(--white);
            border: 1px solid var(--line);
        }

        img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
    }

    .news {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));

        article {
            display: flex;
            flex-direction: column;
            border-radius: 0.75rem;
            overflow: hidden;
            background: var(--component);
        }

        :global(img) {
            width: 100%;
            aspect-ratio: 16 / 10;
            object-fit: cover;
            background: var(--white);
        }

        .theme-visual {
            display: grid;
            place-items: center;
            aspect-ratio: 16 / 10;
            /* Small stars, a few bright ones, then the night sky. */
            background:
                radial-gradient(1px 1px at 12% 18%, #fff 50%, transparent),
                radial-gradient(1px 1px at 28% 72%, #fff 50%, transparent),
                radial-gradient(1.5px 1.5px at 41% 33%, #fff 50%, transparent),
                radial-gradient(1px 1px at 57% 84%, #fff 50%, transparent),
                radial-gradient(2px 2px at 68% 22%, #fff 50%, transparent),
                radial-gradient(1px 1px at 79% 61%, #fff 50%, transparent),
                radial-gradient(1.5px 1.5px at 88% 12%, #fff 50%, transparent),
                radial-gradient(1px 1px at 93% 78%, #fff 50%, transparent),
                radial-gradient(1px 1px at 6% 88%, #fff 50%, transparent),
                radial-gradient(2px 2px at 20% 45%, #fff 50%, transparent),
                radial-gradient(circle at 80% 110%, #d63f49 0%, transparent 45%),
                radial-gradient(circle at 15% -10%, #4b2a7a 0%, transparent 55%), #0d0b1e;

            span {
                font-size: var(--fs5);
                font-weight: 700;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: #fff;
                text-shadow: 0 0 24px rgba(232, 147, 153, 0.8);
            }
        }

        ul {
            display: grid;
            gap: 0.5rem;
            padding-left: 1.25rem;
            color: var(--text-subtle);
        }
    }

    .news-body {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.5rem;
    }

    .note {
        font-size: var(--fs-1);
        color: var(--text-subtle);
    }
</style>
