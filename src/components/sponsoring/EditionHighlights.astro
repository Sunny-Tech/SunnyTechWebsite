---
import { Picture } from 'astro:assets'
import type { OpenPlannerType } from '../../type'
import venue from '../../assets/sponsoring/venue.jpg'
import themeMagic from '../../assets/sponsoring/theme-magic.png'
import standCrowd from '../../assets/sponsoring/stand-crowd.jpg'
import talk from '../../assets/sponsoring/talk.jpg'
import workshop from '../../assets/sponsoring/workshop.jpg'
import ouisnap from '../../assets/sponsoring/ouisnap.jpg'
import volunteers from '../../assets/sponsoring/volunteers.jpg'
import ContentContainer from '../ui-elements/ContentContainer.astro'
import ButtonLink from '../ui-elements/ButtonLink.astro'
import Cluster from '../ui-elements/Cluster.astro'
import { FLASHBACK_FIGURES, FLASHBACK_LINKS, PAST_BRANDS } from './sponsoringData'

interface Props {
    sponsors: OpenPlannerType['sponsors'][number]['sponsors']
}

const { sponsors } = Astro.props

// Brands already shown as a 2026 logo are not repeated in the history list. OpenPlanner
// holds legal names ("Elasticsearch SARL", "TEADS "), hence the substring match.
const sponsorNames = sponsors.map((sponsor) => sponsor.name.toLowerCase())
const pastBrands = PAST_BRANDS.filter((brand) => !sponsorNames.some((name) => name.includes(brand.toLowerCase())))

const gallery = [
    { src: standCrowd, alt: 'Des participant·e·s sur un stand sponsor' },
    { src: talk, alt: 'Un amphithéâtre plein pendant un talk' },
    { src: workshop, alt: 'Un atelier pratique en petit groupe' },
    { src: ouisnap, alt: 'Des participant·e·s devant la borne photo OuiSnap !' },
]

const news = [
    {
        title: 'Faculté des sciences',
        image: venue,
        points: [
            '3 amphithéâtres, 3 salles pour les ateliers, les speakers et les conférences, des espaces verts',
            'Accessible pour toutes et tous',
            'Ligne 1 du tramway à proximité',
        ],
    },
    {
        title: 'Thème 2027 : la magie 🧙',
        image: themeMagic,
        points: [
            'Une thématique renouvelée chaque année',
            'Déco, activités et communication autour du thème',
            'Un accompagnement des sponsors pour s’immerger dans le thème',
        ],
    },
    {
        title: 'Un suivi dédié',
        image: volunteers,
        points: [
            'Une fréquentation accrue de vos stands grâce à un jeu mis en place ensemble*',
            'Un canal Slack dédié pour répondre à vos questions et préparer votre participation',
        ],
        note: '* Réservé aux formules de sponsoring classiques.',
    },
]
---

<ContentContainer spaceBlock="3rem">
    <div class="section-head">
        <h2>L’édition 2026</h2>
    </div>
    <dl class="figures">
        {
            FLASHBACK_FIGURES.map((figure) => (
                <div>
                    <dt>{figure.label}</dt>
                    <dd>{figure.value}</dd>
                </div>
            ))
        }
    </dl>
    <div class="gallery">
        {
            gallery.map((photo) => (
                <Picture
                    src={photo.src}
                    alt={photo.alt}
                    formats={['avif', 'webp']}
                    widths={[400, 700]}
                    sizes="(min-width: 960px) 300px, 50vw"
                />
            ))
        }
    </div>
    <Cluster>
        {
            FLASHBACK_LINKS.map((link) => (
                <ButtonLink href={link.href} target="_blank" rel="noopener noreferrer" external>
                    {link.label}
                </ButtonLink>
            ))
        }
    </Cluster>

    <h2>Ils nous ont fait confiance</h2>
    {
        sponsors.length > 0 && (
            <ul class="logos">
                {sponsors.map((sponsor) => (
                    <li>
                        <img src={sponsor.logoUrl} alt={sponsor.name} loading="lazy" />
                    </li>
                ))}
            </ul>
        )
    }
    <p class="past-intro">Et lors des éditions précédentes :</p>
    <ul class="brands">
        {pastBrands.map((brand) => <li>{brand}</li>)}
    </ul>

    <div class="section-head">
        <h2>En 2027</h2>
    </div>
    <div class="news">
        {
            news.map((item) => (
                <article>
                    <Picture
                        src={item.image}
                        alt=""
                        formats={['avif', 'webp']}
                        widths={[400, 700]}
                        sizes="(min-width: 960px) 400px, 100vw"
                    />
                    <div class="news-body">
                        <h3>{item.title}</h3>
                        <ul>
                            {item.points.map((point) => (
                                <li>{point}</li>
                            ))}
                        </ul>
                        {item.note && <p class="note">{item.note}</p>}
                    </div>
                </article>
            ))
        }
    </div>
</ContentContainer>

<style>
    .figures {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(min(8rem, 100%), 1fr));

        div {
            display: flex;
            flex-direction: column-reverse;
            justify-content: flex-end;
            text-align: center;
        }

        dd {
            font-size: var(--fs5);
            font-weight: 700;
            color: var(--brand-solid);
            line-height: 1.1;
        }

        dt {
            color: var(--text-subtle);
        }
    }

    .gallery {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));

        :global(img) {
            width: 100%;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            border-radius: 0.5rem;
        }
    }

    .logos {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
        list-style: none;

        li {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.75rem;
            aspect-ratio: 3 / 2;
            border-radius: 0.5rem;
            background: var(--white);
            border: 1px solid var(--line);
        }

        img {
            max-height: 100%;
            object-fit: contain;
        }
    }

    .past-intro {
        color: var(--text-subtle);
    }

    .brands {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        list-style: none;

        li {
            padding: 0.5rem 1rem;
            font-size: var(--fs1);
            font-weight: 700;
            letter-spacing: -0.01em;
            border-radius: 999px;
            color: var(--text);
            background: var(--component);
        }
    }

    .news {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));

        article {
            display: flex;
            flex-direction: column;
            border-radius: 0.75rem;
            overflow: hidden;
            background: var(--component);
        }

        :global(img) {
            width: 100%;
            aspect-ratio: 16 / 10;
            object-fit: cover;
            background: var(--white);
        }

        ul {
            display: grid;
            gap: 0.5rem;
            padding-left: 1.25rem;
            color: var(--text-subtle);
        }
    }

    .news-body {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.5rem;
    }

    .note {
        font-size: var(--fs-1);
        color: var(--text-subtle);
    }
</style>
