---
import { OPENPLANNER_URL } from 'astro:env/client'
import type { OpenPlannerType } from '../type'
import Layout from '../layouts/Layout.astro'
import SponsoringHero from '../components/sponsoring/SponsoringHero.astro'
import SponsoringAbout from '../components/sponsoring/SponsoringAbout.astro'
import ClassicOffers from '../components/sponsoring/ClassicOffers.astro'
import SpecialOffers from '../components/sponsoring/SpecialOffers.astro'
import EditionHighlights from '../components/sponsoring/EditionHighlights.astro'
import SponsoringSignup from '../components/sponsoring/SponsoringSignup.astro'
import { EVENT } from '../og/event'

const response = await fetch(OPENPLANNER_URL)
const openPlannerData: OpenPlannerType = await response.json()
// The payload still holds the previous edition's sponsors until the new programme is published.
const pastSponsors = openPlannerData.sponsors
    .filter((category) => !category.name.toLowerCase().includes('partenaire'))
    .sort((a, b) => a.order - b.order)
    .flatMap((category) => category.sponsors)
---

<Layout
    title={`Sponsoriser Sunny Tech ${EVENT.year}`}
    description={`Stands, soirées, recrutement : toutes les formules pour sponsoriser Sunny Tech, les ${EVENT.displayDates} à ${EVENT.city}.`}
    noindex>
    <div class="sponsoring">
        <SponsoringHero />
        <SponsoringAbout />
        <ClassicOffers />
        <SpecialOffers />
        <EditionHighlights sponsors={pastSponsors} />

        <SponsoringSignup />
    </div>
</Layout>

<style>
    .sponsoring :global(.section-head) {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-width: 48rem;
        scroll-margin-top: 5rem;
    }
</style>
